          },
          {
            "name": "IsUnknown",
            "dataType": "boolean",
            "sourceColumn": "IsUnknown"
          },
          {
            "name": "DateStatus",
            "dataType": "string",
            "type": "calculated",
            "isDataTypeInferred": true,
            "expression": "IF(DimDate[IsUnknown], \"Desconocida\", \"Fecha real\")",
            "displayFolder": "Calendario"
          }
        ],
        "partitions": [
          {
            "source": {
              "expression": [
                "let",
                "    Fuente = #\"NorthwindDW\",",
                "    Origen = Fuente{[Schema=\"dbo\", Item=\"DimDate\"]}[Data]",
                "in",
                "    Origen"
              ],
              "type": "m"
            },
            "name": "DimDate",
            "dataView": "full"
          }
        ],
        "hierarchies": [
          {
            "name": "Calendario",
            "levels": [
              {
                "column": "YearNumber",
                "name": "Año",
                "ordinal": 0
              },
              {
                "column": "QuarterNumber",
                "name": "Trimestre",
                "ordinal": 1
              },
              {
                "column": "MonthName",
                "name": "Mes",
                "ordinal": 2
              },
              {
                "column": "FullDate",
                "name": "Fecha",
                "ordinal": 3
              }
            ]
          }
        ]
      },
