          {
            "source": {
              "expression": [
                "let",
                "    Fuente = #\"NorthwindDW\",",
                "    Origen = Fuente{[Schema=\"dbo\", Item=\"Fact_Ventas\"]}[Data]",
                "in",
                "    Origen"
              ],
              "type": "m"
            },
            "name": "Fact_Ventas",
            "dataView": "full"
          }
        ],
        "measures": [
          {
            "name": "Ventas brutas",
            "expression": "SUM(Fact_Ventas[ImporteBruto])",
            "formatString": "$ #,##0.00;-$ #,##0.00;$ 0.00"
          },
          {
            "name": "Descuentos aplicados",
            "expression": "SUM(Fact_Ventas[ImporteDescuento])",
            "formatString": "$ #,##0.00;-$ #,##0.00;$ 0.00"
          },
          {
            "name": "Ventas netas",
            "expression": "SUM(Fact_Ventas[ImporteNeto])",
            "formatString": "$ #,##0.00;-$ #,##0.00;$ 0.00"
          },
          {
            "name": "Unidades",
            "expression": "SUM(Fact_Ventas[Cantidad])",
            "formatString": "#,##0"
          },
          {
            "name": "Pedidos distintos",
            "expression": "DISTINCTCOUNT(Fact_Ventas[OrderID])",
            "formatString": "#,##0"
          },
          {
            "name": "Ventas brutas por fecha requerida",
            "expression": "CALCULATE([Ventas brutas], USERELATIONSHIP(Fact_Ventas[FechaRequerida_SK], Dim_Tiempo[Tiempo_SK]))",
            "formatString": "$ #,##0.00;-$ #,##0.00;$ 0.00",
            "displayFolder": "Fecha requerida"
          },
          {
            "name": "Descuentos por fecha requerida",
            "expression": "CALCULATE([Descuentos aplicados], USERELATIONSHIP(Fact_Ventas[FechaRequerida_SK], Dim_Tiempo[Tiempo_SK]))",
            "formatString": "$ #,##0.00;-$ #,##0.00;$ 0.00",
            "displayFolder": "Fecha requerida"
          },
          {
            "name": "Ventas netas por fecha requerida",
