      {
        "name": "FactSales",
        "description": "Una fila por línea de pedido. Freight se repite en las líneas y se suma una vez por pedido.",
        "columns": [
          {
            "name": "SalesKey",
            "dataType": "int64",
            "sourceColumn": "SalesKey",
            "isHidden": true,
            "isKey": true
          },
          {
            "name": "OrderID",
            "dataType": "int64",
            "sourceColumn": "OrderID",
            "summarizeBy": "none"
          },
          {
            "name": "OrderDateKey",
            "dataType": "int64",
            "sourceColumn": "OrderDateKey",
            "isHidden": true
          },
          {
            "name": "RequiredDateKey",
            "dataType": "int64",
            "sourceColumn": "RequiredDateKey",
            "isHidden": true
          },
          {
            "name": "ShippedDateKey",
            "dataType": "int64",
            "sourceColumn": "ShippedDateKey",
            "isHidden": true
          },
          {
            "name": "ProductKey",
            "dataType": "int64",
            "sourceColumn": "ProductKey",
            "isHidden": true
          },
          {
            "name": "CustomerKey",
            "dataType": "int64",
            "sourceColumn": "CustomerKey",
            "isHidden": true
          },
          {
            "name": "EmployeeKey",
            "dataType": "int64",
            "sourceColumn": "EmployeeKey",
            "isHidden": true
          },
          {
            "name": "ShipperKey",
            "dataType": "int64",
            "sourceColumn": "ShipperKey",
            "isHidden": true
          },
          {
            "name": "SupplierKey",
            "dataType": "int64",
            "sourceColumn": "SupplierKey",
            "isHidden": true
          },
          {
            "name": "GeographyKey",
            "dataType": "int64",
            "sourceColumn": "GeographyKey",
            "isHidden": true
          },
          {
            "name": "Quantity",
            "dataType": "int64",
            "sourceColumn": "Quantity",
            "isHidden": true
          },
          {
            "name": "UnitPrice",
            "dataType": "decimal",
            "sourceColumn": "UnitPrice",
            "isHidden": true
          },
          {
            "name": "Discount",
            "dataType": "decimal",
            "sourceColumn": "Discount",
            "isHidden": true
          },
          {
            "name": "Freight",
            "dataType": "decimal",
            "sourceColumn": "Freight",
            "isHidden": true
          },
          {
            "name": "GrossAmount",
            "dataType": "decimal",
            "sourceColumn": "GrossAmount",
            "isHidden": true
          },
          {
            "name": "DiscountAmount",
            "dataType": "decimal",
            "sourceColumn": "DiscountAmount",
            "isHidden": true
          },
          {
            "name": "NetAmount",
            "dataType": "decimal",
            "sourceColumn": "NetAmount",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "source": {
              "expression": [
                "let",
                "    Fuente = #\"NorthwindDW\",",
                "    Origen = Fuente{[Schema=\"dbo\", Item=\"FactSales\"]}[Data]",
                "in",
                "    Origen"
              ],
              "type": "m"
            },
            "name": "FactSales",
            "dataView": "full"
          }
        ],
        "measures": [
          {
            "name": "Ventas brutas",
            "expression": "SUM(FactSales[GrossAmount])",
            "formatString": "$ #,##0.00;-$ #,##0.00;$ 0.00",
            "description": "Suma el bruto calculado por línea.",
            "displayFolder": "Ventas"
          },
          {
            "name": "Descuentos aplicados",
            "expression": "SUM(FactSales[DiscountAmount])",
            "formatString": "$ #,##0.00;-$ #,##0.00;$ 0.00",
            "description": "Suma el descuento monetario calculado por línea.",
            "displayFolder": "Ventas"
          },
          {
            "name": "Ventas netas",
            "expression": "SUM(FactSales[NetAmount])",
            "formatString": "$ #,##0.00;-$ #,##0.00;$ 0.00",
            "description": "Suma bruto menos descuento; no incluye Freight.",
            "displayFolder": "Ventas"
          },
          {
            "name": "Unidades",
            "expression": "SUM(FactSales[Quantity])",
            "formatString": "#,##0",
            "description": "Cantidad de unidades vendidas.",
            "displayFolder": "Ventas"
          },
          {
            "name": "Pedidos distintos",
            "expression": "DISTINCTCOUNT(FactSales[OrderID])",
            "formatString": "#,##0",
            "description": "Cuenta pedidos distintos, no líneas.",
            "displayFolder": "Pedidos"
          },
          {
            "name": "Flete total",
            "expression": "SUMX(VALUES(FactSales[OrderID]), CALCULATE(MAX(FactSales[Freight])))",
            "formatString": "#,##0.0000;[Red]-#,##0.0000;0.0000",
            "description": "Suma el Freight del pedido una sola vez. Los subtotales por producto o proveedor pueden solaparse; no se deben sumar entre categorías.",
            "displayFolder": "Flete"
          },
          {
            "name": "Pedidos sin flete informado",
            "expression": "SUMX(VALUES(FactSales[OrderID]), IF(ISBLANK(CALCULATE(MAX(FactSales[Freight]))), 1, 0))",
            "formatString": "#,##0",
            "description": "Cuenta pedidos cuyo Freight es NULL. Un Freight igual a cero sí se considera informado.",
            "displayFolder": "Flete"
          },
          {
            "name": "Ventas brutas por fecha requerida",
            "expression": "CALCULATE([Ventas brutas], USERELATIONSHIP(FactSales[RequiredDateKey], DimDate[DateKey]))",
            "formatString": "$ #,##0.00;-$ #,##0.00;$ 0.00",
            "description": "Aplica la medida con el rol de fecha 'Fecha requerida'.",
            "displayFolder": "Fecha requerida"
          },
          {
            "name": "Descuentos aplicados por fecha requerida",
            "expression": "CALCULATE([Descuentos aplicados], USERELATIONSHIP(FactSales[RequiredDateKey], DimDate[DateKey]))",
            "formatString": "$ #,##0.00;-$ #,##0.00;$ 0.00",
            "description": "Aplica la medida con el rol de fecha 'Fecha requerida'.",
            "displayFolder": "Fecha requerida"
          },
          {
            "name": "Ventas netas por fecha requerida",
            "expression": "CALCULATE([Ventas netas], USERELATIONSHIP(FactSales[RequiredDateKey], DimDate[DateKey]))",
            "formatString": "$ #,##0.00;-$ #,##0.00;$ 0.00",
            "description": "Aplica la medida con el rol de fecha 'Fecha requerida'.",
            "displayFolder": "Fecha requerida"
          },
          {
            "name": "Unidades por fecha requerida",
            "expression": "CALCULATE([Unidades], USERELATIONSHIP(FactSales[RequiredDateKey], DimDate[DateKey]))",
            "formatString": "#,##0",
            "description": "Aplica la medida con el rol de fecha 'Fecha requerida'.",
            "displayFolder": "Fecha requerida"
          },
          {
            "name": "Pedidos distintos por fecha requerida",
            "expression": "CALCULATE([Pedidos distintos], USERELATIONSHIP(FactSales[RequiredDateKey], DimDate[DateKey]))",
            "formatString": "#,##0",
            "description": "Aplica la medida con el rol de fecha 'Fecha requerida'.",
            "displayFolder": "Fecha requerida"
          },
          {
            "name": "Flete total por fecha requerida",
            "expression": "CALCULATE([Flete total], USERELATIONSHIP(FactSales[RequiredDateKey], DimDate[DateKey]))",
            "formatString": "#,##0.0000;[Red]-#,##0.0000;0.0000",
            "description": "Aplica la medida con el rol de fecha 'Fecha requerida'.",
            "displayFolder": "Fecha requerida"
          },
          {
