      {
        "name": "DimDate",
        "description": "Calendario compartido por fecha de pedido, requerida y envío.",
        "columns": [
          {
            "name": "DateKey",
            "dataType": "int64",
            "sourceColumn": "DateKey",
            "isHidden": true,
            "isKey": true
          },
          {
            "name": "FullDate",
            "dataType": "dateTime",
            "sourceColumn": "FullDate",
            "formatString": "dd/MM/yyyy"
          },
          {
            "name": "DayNumber",
            "dataType": "int64",
            "sourceColumn": "DayNumber"
          },
          {
            "name": "DayName",
            "dataType": "string",
            "sourceColumn": "DayName"
          },
          {
            "name": "MonthNumber",
            "dataType": "int64",
            "sourceColumn": "MonthNumber",
            "isHidden": true
          },
          {
            "name": "MonthName",
            "dataType": "string",
            "sourceColumn": "MonthName",
            "summarizeBy": "none"
          },
          {
            "name": "QuarterNumber",
            "dataType": "int64",
            "sourceColumn": "QuarterNumber"
          },
          {
            "name": "YearNumber",
