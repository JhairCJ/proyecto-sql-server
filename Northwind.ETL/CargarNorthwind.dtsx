          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:PropertyExpression
            DTS:Name="SqlStatementSource">"IF " + (DT_WSTR,20)@[User::EndRow] + " &lt; " + (DT_WSTR,20)@[User::StartRow] + " THROW 52401,'Corte incompatible con el avance.',1; DELETE std.Producto;"</DTS:PropertyExpression>
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{1D8C7EF7-DAF1-4DE3-8127-36946FB9AFEF}"
              SQLTask:SqlStatementSource="IF 0 &lt; 0 THROW 52401,'Corte incompatible con el avance.',1; DELETE std.Producto;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
