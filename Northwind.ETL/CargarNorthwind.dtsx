            <SQLTask:SqlTaskData SQLTask:Connection="{1D8C7EF7-DAF1-4DE3-8127-36946FB9AFEF}" SQLTask:SqlStatementSource="IF DB_NAME()&lt;&gt;N'Northwind_DW' AND NOT EXISTS(SELECT 1 FROM sys.extended_properties WHERE class=0 AND name=N'NorthwindPracticeTestDatabase' AND CONVERT(nvarchar(128),value)=N'Northwind_DW') THROW 51002,'SSIS: use Northwind_DW o una copia de practica identificada.',1;IF CONTEXT_INFO() IS NULL OR CONTEXT_INFO()&lt;&gt;0x01020304 THROW 52530,'Control de carga no compartido',1;DECLARE @r int;EXEC @r=sys.sp_getapplock @Resource=N'Northwind.Warehouse.Load',@LockMode=N'Exclusive',@LockOwner=N'Session',@LockTimeout=0;IF @r&lt;0 THROW 52402,'DW ocupado por otra carga; staging intacto.',1;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
