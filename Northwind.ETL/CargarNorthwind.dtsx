        <DTS:Executable
          DTS:refId="Package\Cargar Producto\Preparar staging"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:DTSID="{60F20EBA-D790-4DF8-8373-F06A985198BB}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:FailPackageOnFailure="True"
          DTS:FailParentOnFailure="True"
          DTS:LocaleID="-1"
          DTS:ObjectName="Preparar staging"
