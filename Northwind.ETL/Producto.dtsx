    <DTS:Executable DTS:refId="Package\Liberar bloqueo de entidad" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:DTSID="{0C9FA492-06AC-4B38-B095-EF81DE3F5B8D}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:FailPackageOnFailure="True" DTS:FailParentOnFailure="True" DTS:LocaleID="-1" DTS:ObjectName="Liberar bloqueo de entidad" DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1" DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{1D8C7EF7-DAF1-4DE3-8127-36946FB9AFEF}" SQLTask:SqlStatementSource="EXEC sys.sp_releaseapplock @Resource=N'Northwind.Warehouse.Load',@LockOwner=N'Session';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Preparar staging" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:DTSID="{57AB433C-8EC6-47BD-9338-D618463D0C08}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:FailPackageOnFailure="True" DTS:FailParentOnFailure="True" DTS:LocaleID="-1" DTS:ObjectName="Preparar staging" DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1" DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:PropertyExpression DTS:Name="SqlStatementSource">"IF " + (DT_WSTR,20)@[User::EndRow] + " &lt; " + (DT_WSTR,20)@[User::StartRow] + " THROW 52401,'Corte incompatible con el avance.',1; DELETE std.Producto;"</DTS:PropertyExpression>
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{1D8C7EF7-DAF1-4DE3-8127-36946FB9AFEF}" SQLTask:SqlStatementSource="IF 0 &lt; 0 THROW 52401,'Corte incompatible con el avance.',1; DELETE std.Producto;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Validar destino y bloquear" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:DTSID="{60AF769E-748D-42D4-81F4-8FAB7AECB028}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:FailPackageOnFailure="True" DTS:FailParentOnFailure="True" DTS:LocaleID="-1" DTS:ObjectName="Validar destino y bloquear" DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1" DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{1D8C7EF7-DAF1-4DE3-8127-36946FB9AFEF}" SQLTask:SqlStatementSource="IF DB_NAME()&lt;&gt;N'Northwind_DW' AND NOT EXISTS(SELECT 1 FROM sys.extended_properties WHERE class=0 AND name=N'NorthwindPracticeTestDatabase' AND CONVERT(nvarchar(128),value)=N'Northwind_DW') THROW 51002,'SSIS: use Northwind_DW o una copia de practica identificada.',1;DECLARE @r int;EXEC @r=sys.sp_getapplock @Resource=N'Northwind.Warehouse.Load',@LockMode=N'Exclusive',@LockOwner=N'Session',@LockTimeout=0;IF @r&lt;0 THROW 52402,'DW ocupado por otra carga; staging intacto.',1;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\Validar origen y fijar corte" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:DTSID="{0A7859E3-D1E2-4287-AE79-C663C51E77FF}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:FailPackageOnFailure="True" DTS:FailParentOnFailure="True" DTS:LocaleID="-1" DTS:ObjectName="Validar origen y fijar corte" DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1" DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData SQLTask:Connection="{36408304-1EEF-431A-A523-4229BE67C90E}" SQLTask:SqlStatementSource="IF DB_NAME()&lt;&gt;N'NorthWind' AND NOT EXISTS(SELECT 1 FROM sys.extended_properties WHERE class=0 AND name=N'NorthwindPracticeTestDatabase' AND CONVERT(nvarchar(128),value)=N'NorthWind') THROW 51002,'SSIS: use NorthWind o una copia de practica identificada.',1;EXEC dbo.GetDatabaseRowVersion;" SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding SQLTask:ResultName="0" SQLTask:DtsVariableName="User::EndRow" />
